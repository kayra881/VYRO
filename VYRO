<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
let saved = [];
let toastTimer;

function toast(message) {
  const el = $('#toast');
  el.textContent = message;
  el.style.display = 'block';
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.style.display = 'none', 2600);
}

function navigate(page) {
  $$('.page').forEach(el => el.classList.toggle('active', el.id === page));
  $$('[data-page]').forEach(el => el.classList.toggle('active', el.dataset.page === page));
  window.scrollTo({top:0, behavior:'smooth'});
}

$$('[data-page]').forEach(btn =>
  btn.addEventListener('click', () => navigate(btn.dataset.page))
);
$$('[data-go]').forEach(btn =>
  btn.addEventListener('click', () => navigate(btn.dataset.go))
);

function applyTheme(value) {
  document.body.classList.toggle('light', value === 'light');
  if (value === 'system') {
    document.body.classList.toggle(
      'light',
      window.matchMedia('(prefers-color-scheme: light)').matches
    );
  }
  localStorage.setItem('vyro-theme', value);
  $('#theme').value = value;
}
applyTheme(localStorage.getItem('vyro-theme') || 'system');

$('#theme').addEventListener('change', e => {
  applyTheme(e.target.value);
  toast('Tema tercihi kaydedildi.');
});
$('#themeButton').addEventListener('click', () => {
  const current = localStorage.getItem('vyro-theme') || 'system';
  applyTheme(current === 'dark' ? 'light' : current === 'light' ? 'system' : 'dark');
  toast('Tema değiştirildi.');
});

$$('.like').forEach(btn => btn.addEventListener('click', () => {
  const liked = btn.classList.toggle('primary');
  btn.textContent = liked ? '♥ Beğenildi' : '♡ Beğen';
}));

$$('.save').forEach(btn => btn.addEventListener('click', () => {
  const title = btn.dataset.title;
  if (saved.includes(title)) {
    saved = saved.filter(item => item !== title);
    btn.textContent = '▣ Kaydet';
  } else {
    saved.push(title);
    btn.textContent = '✓ Kaydedildi';
  }
  renderSaved();
}));

function renderSaved() {
  const list = $('#savedList');
  if (!saved.length) {
    list.textContent = 'Henüz video kaydetmedin.';
    return;
  }
  list.innerHTML = '';
  saved.forEach(title => {
    const row = document.createElement('p');
    row.textContent = title + ' ';
    const remove = document.createElement('button');
    remove.textContent = 'Kaldır';
    remove.addEventListener('click', () => {
      saved = saved.filter(item => item !== title);
      $$('.save').forEach(btn => {
        if (btn.dataset.title === title) btn.textContent = '▣ Kaydet';
      });
      renderSaved();
    });
    row.appendChild(remove);
    list.appendChild(row);
  });
}

$$('#interests button').forEach(btn => btn.addEventListener('click', () =>
  btn.classList.toggle('primary')
));
$('#saveInterests').addEventListener('click', () => {
  const selected = $$('#interests .primary').map(btn => btn.textContent);
  localStorage.setItem('vyro-interests', JSON.stringify(selected));
  toast('İlgi alanların kaydedildi.');
});
const oldInterests = JSON.parse(localStorage.getItem('vyro-interests') || 'null');
if (oldInterests) {
  $$('#interests button').forEach(btn =>
    btn.classList.toggle('primary', oldInterests.includes(btn.textContent))
  );
}

$('#accent').addEventListener('change', e => {
  document.documentElement.style.setProperty('--accent', e.target.value);
});
$('#editProfile').addEventListener('click', () => {
  $('#profileForm').hidden = !$('#profileForm').hidden;
});
$('#saveProfile').addEventListener('click', () => {
  const name = $('#nameInput').value.trim() || 'VYRO Kullanıcısı';
  const handle = $('#handleInput').value.toLowerCase().replace(/[^a-z0-9._]/g,'') || 'vyro_user';
  $('#displayName').textContent = name;
  $('#handle').textContent = '@' + handle;
  $('#avatar').textContent = name[0].toUpperCase();
  $('#bio').textContent = $('#bioInput').value.slice(0,160);
  $('#profileForm').hidden = true;
  toast('Profil demo olarak güncellendi.');
});

$$('[data-msg]').forEach(btn =>
  btn.addEventListener('click', () => toast(btn.dataset.msg))
);

$('#analyze').addEventListener('click', () => {
  const niche = $('#niche').value;
  const goal = $('#goal').value;
  const tips = niche.includes('Oyun')
    ? ['En iyi anı ilk 1–2 saniyede göster.',
       'Tek videoda tek bir taktik anlat.',
       'Klip ve rehber performanslarını ayrı ölç.']
    : ['Videonun ana fikrini başta netleştir.',
       'Tek izleyici ihtiyacına odaklan.',
       'Kaydetme ve paylaşma oranlarını karşılaştır.'];

  const result = document.createElement('div');
  result.className = 'card';
  const heading = document.createElement('h2');
  heading.textContent = 'Demo analiz: ' + goal;
  result.appendChild(heading);

  tips.forEach((tip, i) => {
    const p = document.createElement('p');
    p.textContent = (i + 1) + '. ' + tip;
    result.appendChild(p);
  });

  const note = document.createElement('p');
  note.className = 'notice';
  note.textContent = 'Bu, örnek kurallardan oluşturulan bir yanıttır. Gerçek hesap taraması veya AI çağrısı yapılmadı.';
  result.appendChild(note);

  $('#aiResult').replaceChildren(result);
});

$('#story').addEventListener('click', () => {
  $('#aiResult').textContent =
    'Gerçek sürümde doğrulanabilir kaynaklarla desteklenen içerik üreticisi hikâyeleri gösterilecek. Bu prototip kaynak araştırması yapmaz ve gerçek kişi hikâyesi uydurmaz.';
});

let live = false;
$('#simulate').addEventListener('click', () => {
  live = !live;
  $('#viewers').textContent = live ? '124' : '—';
  $('#chat').textContent = live ? '86' : '—';
  $('#follows').textContent = live ? '12' : '—';
  $('#peak').textContent = live ? '02:14' : '—';
  $('#liveSummary').textContent = live
    ? 'Demo verileri gösteriliyor. Gerçek yayın açılmadı.'
    : 'Gerçek yayın açılmaz; yalnızca demo simülasyonu.';
  $('#simulate').textContent = live ? 'Simülasyonu sıfırla' : 'Demo yayını simüle et';
});

$('#search').addEventListener('keydown', e => {
  if (e.key === 'Enter' && e.target.value.trim()) {
    navigate('explore');
    toast('Demo araması. Gerçek arama servisi henüz bağlı değil.');
  }
});
</script>
</body>
</html>
