
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VYRO</title>
<style>
:root {
  --bg:#101018;
  --panel:#191925;
  --text:#f5f5fc;
  --muted:#aaaac0;
  --accent:#8b5cf6;
  --border:#323247;
}
* { box-sizing:border-box; }
body {
  margin:0;
  font-family:system-ui,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
}
body.light {
  --bg:#f5f5fa;
  --panel:#fff;
  --text:#191927;
  --muted:#69697e;
  --border:#dedeea;
}
header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16px 24px;
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  background:var(--bg);
}
.logo {
  font-size:25px;
  font-weight:900;
  letter-spacing:3px;
}
button,input,textarea,select { font:inherit; }
button {
  background:var(--panel);
  color:var(--text);
  border:1px solid var(--border);
  padding:10px 14px;
  border-radius:10px;
  cursor:pointer;
}
button:hover { border-color:var(--accent); }
.primary {
  background:var(--accent);
  color:white;
  border-color:var(--accent);
}
.layout {
  display:grid;
  grid-template-columns:210px 1fr;
  max-width:1450px;
  margin:auto;
}
aside {
  padding:20px 12px;
  border-right:1px solid var(--border);
  min-height:calc(100vh - 65px);
}
nav button {
  display:block;
  width:100%;
  text-align:left;
  border:0;
  margin:4px 0;
  background:transparent;
  color:var(--muted);
}
nav button.active {
  background:var(--panel);
  color:var(--text);
}
main { padding:26px; min-width:0; }
.page { display:none; max-width:1100px; margin:auto; }
.page.active { display:block; }
h1 { font-size:32px; margin-bottom:6px; }
.muted { color:var(--muted); }
.card {
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:16px;
  padding:18px;
  margin-bottom:15px;
}
.hero {
  padding:26px;
  border-radius:20px;
  margin-bottom:20px;
  background:linear-gradient(120deg,#5127a5,#191925 75%);
}
.hero h2 { font-size:27px; }
.grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:14px;
}
.video {
  aspect-ratio:9/12;
  border-radius:12px;
  display:flex;
  justify-content:center;
  align-items:center;
  background:linear-gradient(140deg,#7c3aed,#2563eb);
  font-size:30px;
}
.video.pink { background:linear-gradient(140deg,#be185d,#fb923c); }
.video.green { background:linear-gradient(140deg,#0f766e,#a3e635); }
.metrics {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;
}
.metric strong {
  display:block;
  font-size:27px;
  margin-top:12px;
}
.field {
  display:block;
  width:100%;
  background:var(--bg);
  color:var(--text);
  border:1px solid var(--border);
  border-radius:10px;
  padding:11px;
  margin:8px 0 15px;
}
.row {
  display:flex;
  gap:10px;
  align-items:center;
  flex-wrap:wrap;
}
.setting {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:14px 0;
  border-bottom:1px solid var(--border);
}
.setting:last-child { border:0; }
.setting small {
  display:block;
  color:var(--muted);
}
.banner {
  height:155px;
  border-radius:16px;
  background:linear-gradient(110deg,#6d28d9,#2563eb,#0f766e);
}
.avatar {
  width:75px;
  height:75px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#302348;
  border:5px solid var(--bg);
  font-size:25px;
  font-weight:bold;
}
.profile-head {
  display:flex;
  align-items:center;
  gap:14px;
  margin:-30px 15px 15px;
}
.notice {
  color:var(--muted);
  font-size:12px;
  padding:12px;
  background:var(--panel);
  border-radius:10px;
  margin-top:15px;
}
@media(max-width:800px) {
  .layout { grid-template-columns:155px 1fr; }
  main { padding:15px; }
  .metrics { grid-template-columns:repeat(2,1fr); }
  .grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media(max-width:560px) {
  header { padding:13px; }
  .layout { display:block; }
  aside { display:none; }
  main { padding:13px 10px 80px; }
  .grid { gap:9px; }
  h1 { font-size:27px; }
  .mobile-nav {
    display:flex;
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    background:var(--panel);
    border-top:1px solid var(--border);
    justify-content:space-around;
    padding:8px 2px;
    z-index:5;
  }
  .mobile-nav button {
    border:0;
    background:transparent;
    padding:5px;
    font-size:11px;
  }
}
.mobile-nav { display:none; }
.toast {
  display:none;
  position:fixed;
  bottom:25px;
  left:50%;
  transform:translateX(-50%);
  background:var(--text);
  color:var(--bg);
  padding:12px 18px;
  border-radius:10px;
  z-index:10;
}
</style>
</head>
<body>

